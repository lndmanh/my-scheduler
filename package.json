{
  "name": "scheduler",
  "version": "1.0",
  "private": true,
  "description": "A Nuxt 3 starter template with NuxtHub, Auth, and PWA support",
  "author": {
    "name": "No Name Studio",
    "email": "contact@nnsvn.me"
  },
  "type": "module",
  "scripts": {
    "build": "pwa-assets-generator && nuxt build",
    "dev": "pwa-assets-generator && nuxt dev --port=4000",
    "deploy": "npx wrangler d1 migrations apply DB --remote && npx wrangler deploy",
    "generate": "pwa-assets-generator && nuxt generate",
    "preview": "nuxt preview --port=4000",
    "postinstall": "nuxt prepare",
    "lint": "oxlint && eslint .",
    "lint:fix": "oxlint --fix && eslint . --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "db:generate": "npx nuxt db generate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@lucide/vue": "^1.28.0",
    "@nuxt/fonts": "^0.14.0",
    "@nuxthub/core": "^0.10.8",
    "@nuxtjs/device": "^4.0.0",
    "@nuxtjs/tailwindcss": "^7.0.0-beta.1",
    "@pinia/nuxt": "^1.0.1",
    "@simplewebauthn/browser": "^11.0.0",
    "@simplewebauthn/server": "^11.0.0",
    "@tanstack/vue-table": "^9.1.2",
    "@tanstack/vue-virtual": "^3.13.35",
    "@unhead/vue": "^2.0.19",
    "@vee-validate/nuxt": "^5.0.0-beta.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^14.4.0",
    "@vueuse/nuxt": "^14.4.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "es-toolkit": "^1.50.0",
    "file-saver": "^2.0.5",
    "gsap": "^3.15.0",
    "luxon": "^3.7.2",
    "motion-v": "^2.3.0",
    "nuxt": "^4.4.5",
    "nuxt-auth-utils": "^0.5.30",
    "nuxt-security": "^2.6.0",
    "pinia": "^4.0.2",
    "pretty-bytes": "^7.1.1",
    "qrcode": "^1.5.4",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul-vue": "^0.4.1",
    "vee-validate": "^5.0.0-beta.1",
    "vue": "^3.5.25",
    "vue-router": "^5.2.0",
    "vue-sonner": "^2.0.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "^1.16.0",
    "@nuxtjs/color-mode": "^4.0.1",
    "@stylistic/eslint-plugin": "^5.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/file-saver": "^2.0.7",
    "@types/luxon": "^3.7.4",
    "@types/node": "^24.10.1",
    "@types/qrcode": "^1.5.4",
    "@vite-pwa/assets-generator": "^1.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-oxlint": "^1.77.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "shadcn-nuxt": "^2.8.1",
    "tw-animate-css": "^1.4.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
